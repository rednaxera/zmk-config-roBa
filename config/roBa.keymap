#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        sym_left: sym_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp H &kp D &kp Y &kp SPACE &kp ENTER>;
        };

        sym_right: sym_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp M &kp G &kp Y &kp SPACE &kp ENTER>;
        };

        sym_kome: sym_kome {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp K &kp M &kp J &kp SPACE &kp ENTER>;
        };

        sym_star: sym_star {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp K &kp B &kp S &kp SPACE &kp ENTER>;
        };

        sym_white_star: sym_white_star {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp S &kp B &kp S &kp SPACE &kp ENTER>;
        };

        sym_white_circle: sym_white_circle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp I &kp M &kp R &kp SPACE &kp ENTER>;
        };

        sym_double_circle: sym_double_circle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp N &kp M &kp R &kp SPACE &kp ENTER>;
        };

        sym_black_circle: sym_black_circle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp K &kp M &kp R &kp SPACE &kp ENTER>;
        };

        shift_caps: shift_caps {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;

            label = "SHIFT_CAPS";
        };

        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(EQUAL)>;
        };

        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(MINUS)>;
        };

        small_bra: small_bra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT>;
            label = "SMALL_BRA";
        };

        Big_Bra: Big_Bra {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "BIG_BRA";
        };

        zoom_encoder: zoom_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in>, <&zoom_out>;

            tap-ms = <2>;
            label = "ZOOM_ENCODER";
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <100>;
        };

        volume_encoder: volume_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_VOL_DN>;

            tap-ms = <5>;
        };

        BS_DEL: BS_DEL {
            compatible = "zmk,behavior-tap-dance";
            label = "BS_DEL";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&kp DEL>, <&key_repeat>;
        };

        Ctrl_Esc: Ctrl_Esc {
            compatible = "zmk,behavior-tap-dance";
            label = "CTRL_ESC";
            #binding-cells = <0>;
            bindings = <&kp RCTRL>, <&kp ESCAPE>;
        };

        lt_to_base: lt_to_base {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&to>;
        };

        Ht_kp: Ht_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        Lang_Switch: Lang_Switch {
            compatible = "zmk,behavior-tap-dance";
            label = "LANG_SWITCH";
            #binding-cells = <0>;
            bindings = <&kp LA(GRAVE)>, <&kp LANG_HANGEUL>, <&kp LANGUAGE_2>;
        };

        SL_BSL_AT: SL_BSL_AT {
            compatible = "zmk,behavior-tap-dance";
            label = "SL_BSL_AT";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp NON_US_BACKSLASH>, <&kp AT_SIGN>;
        };

        mns_pls_tld: mns_pls_tld {
            compatible = "zmk,behavior-tap-dance";
            label = "MNS_PLS_TLD";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp PLUS>, <&kp LS(GRAVE)>;
        };

        Cln_Str_Amp: Cln_Str_Amp {
            compatible = "zmk,behavior-tap-dance";
            label = "CLN_STR_AMP";
            #binding-cells = <0>;
            bindings = <&kp COLON>, <&kp STAR>, <&kp AMPERSAND>;
        };

        HT_Mouse: HT_Mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_MOUSE";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        HT_Lan_Esc: HT_Lan_Esc {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LAN_ESC";
            bindings = <&kp>, <&Lang_Switch>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W      &kp E           &kp R              &kp T                                                                           &kp Y     &kp U  &lt 5 I    &kp O    &kp P
&kp A             &kp S      &kp D           &kp F              &kp G                 &kp LS(LG(S))                  &SL_BSL_AT                 &kp H     &kp J  &kp K      &kp L    &mns_pls_tld
&mt LEFT_SHIFT Z  &kp X      &kp C           &kp V              &kp B                 &Ht_kp RIGHT_ALT LEFT_ALT      &Ht_kp RIGHT_ALT LEFT_ALT  &kp N     &kp M  &kp COMMA  &kp DOT  &mkp MB2
&Cln_Str_Amp      &lt 1 TAB  &kp LEFT_SHIFT  &kp RIGHT_CONTROL  &HT_Lan_Esc ESCAPE 0  &lt 2 SPACE                    &lt 3 ENTER                &mkp MB1                             &kp BACKSPACE
            >;

            sensor-bindings = <&zoom_encoder>;
        };

        FUNCTION {
            bindings = <
&kp F1     &kp F2      &kp F3     &kp F4           &kp F5                                 &kp F6        &kp F7        &kp F8        &kp F9        &kp F10
&kp F11    &kp F12     &kp F13    &kp F14          &kp F15            &trans      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&sym_left  &sym_right  &sym_kome  &sym_white_star  &sym_white_circle  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans     &trans      &trans     &trans           &trans             &trans      &trans  &trans                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_UP K_SCROLL_UP>;
        };

        NUM {
            bindings = <
&kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PERIOD  &kp ENTER                                                   &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp COLON   &mns_pls_tld   &kp LC(LA(KP_NUMBER_0))      &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &SL_BSL_AT  &kp BACKSPACE  &kp EQUAL                    &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &trans
&kp KP_NUMBER_0  &trans           &trans           &trans      &trans         &trans                       &trans          &trans                                                                     &kp DELETE
            >;

            sensor-bindings = <&volume_encoder>;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans    &trans        &trans     &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &kp HOME  &kp UP_ARROW  &kp END    &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                     &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans       &trans                                                  &trans
            >;
        };
    };
};
